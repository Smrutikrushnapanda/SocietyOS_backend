# SocietyOS Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

NODE_ENV=development
PORT=5050

# PostgreSQL (Neon or other)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_TOKEN_SECRET=<min-32-char-secret>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_SECRET=<min-32-char-secret>
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Swagger
SWAGGER_TITLE=SocietyOS API
SWAGGER_DESCRIPTION=Multi-tenant residential society management platform
SWAGGER_VERSION=1.0.0

# CORS
CORS_ORIGIN=http://localhost:3000

# TypeORM synchronize (true for dev only, false for production)
DB_SYNCHRONIZE=true

# Firebase Admin SDK (backend only — never expose to frontend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
