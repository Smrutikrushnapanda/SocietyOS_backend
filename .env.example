# SocietyOS Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

NODE_ENV=development
PORT=5050

# PostgreSQL (Neon or other)
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_TOKEN_SECRET=<min-32-char-secret>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_SECRET=<min-32-char-secret>
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Swagger
SWAGGER_TITLE=SocietyOS API
SWAGGER_DESCRIPTION=Multi-tenant residential society management platform
SWAGGER_VERSION=1.0.0

# CORS (comma-separated origins allowed in production, e.g. https://societyos.app)
CORS_ORIGIN=http://localhost:3000

# TypeORM synchronize (true for local development only, MUST BE false for production)
DB_SYNCHRONIZE=false

# Opt in to SQL query logs during development (always disabled in production).
DB_LOG_QUERIES=false

# Notice dispatch workers. Keep disabled until the notice publication migration is applied.
NOTICE_DELIVERY_ENABLED=false
NOTICE_SCHEDULER_ENABLED=false
FCM_DISPATCH_ENABLED=false
POLL_PUSH_DELIVERY_ENABLED=false
# Explicitly disable historical notice push while rolling out poll push only.
NOTICE_PUSH_DELIVERY_ENABLED=false

# Swagger API Documentation (disabled in production unless ENABLE_SWAGGER=true)
ENABLE_SWAGGER=false

# Firebase Admin SDK (backend only — never expose to frontend)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required in production to authenticate WhatsApp webhook requests.
WAHA_WEBHOOK_SECRET=
